# ── AI provider (pick ONE) ──────────────────────────────────────────
AI_PROVIDER=gemini

# Google AI Studio key — AIza... (standard) or AQ.... (new auth key)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_aiza_key_here

# OpenRouter (only if AI_PROVIDER=openrouter) — starts with sk-or-
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Models ────────────────────────────────────────────────────────────
# Every model name is read ONLY from this file — the code has no built-in defaults.
# A missing required model shows up as ⚠️ in the startup log and as a clear API error.
#   *_VISION_MODEL         OCR + text translation (image IN → text OUT)       required
#   *_IMAGE_MODEL          translate image (image IN → image OUT)             required
#   *_ENHANCE_IMAGE_MODEL  enhance tool; uses *_IMAGE_MODEL when not set      optional
#   *_MODELS               same key + S: comma-separated fallbacks, tried in order after the primary

# ── Direct Gemini models (AI_PROVIDER=gemini) ───────────────────────
# Image examples: gemini-2.5-flash-image, gemini-3.1-flash-image, gemini-3.1-flash-lite-image, gemini-3-pro-image
# Vision examples: gemini-2.5-pro (best Cyrillic OCR), gemini-2.5-flash (faster / cheaper)
GEMINI_VISION_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_ENHANCE_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MODELS=gemini-2.5-flash
# GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image

# ── OpenRouter models (AI_PROVIDER=openrouter) ────────────────────────
# Full OpenRouter slugs (provider/model). VISION + IMAGE are required for each family in OPENROUTER_UI_FAMILIES.
#
# Gemini family (shown as "Gemini" in UI):
# OPENROUTER_GEMINI_VISION_MODEL=google/gemini-2.5-pro
# OPENROUTER_GEMINI_IMAGE_MODEL=google/gemini-3-pro-image-preview
# OPENROUTER_GEMINI_ENHANCE_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
#
# OpenAI family (shown as "OpenAI" in UI):
# OPENROUTER_OPENAI_VISION_MODEL=openai/gpt-4o
# OPENROUTER_OPENAI_IMAGE_MODEL=openai/gpt-image-2
# OPENROUTER_OPENAI_ENHANCE_IMAGE_MODEL=openai/gpt-image-1-mini
#   Other image models: openai/gpt-image-1, openai/gpt-image-1-mini, openai/gpt-5.4-image-2
#   Uses OpenRouter Image API (POST /api/v1/images) with input_references for scan editing
# After the OpenAI image models, also try the Gemini family image models (default false):
# OPENROUTER_OPENAI_IMAGE_FALLBACK_TO_GEMINI=true
#
# Translation tool (OCR, text translation, image render) is not selectable in the UI —
# it always uses this family's VISION + IMAGE models (gemini | openai, default openai).
# The UI family switch below only applies to the Enhance tool.
TRANSLATION_MODEL_FAMILY=openai
#
# Optional fallback chains:
# OPENROUTER_GEMINI_IMAGE_MODELS=google/gemini-2.5-flash-image-preview,google/imagen-3.0-generate-002
# OPENROUTER_OPENAI_IMAGE_MODELS=openai/gpt-image-1
#
# Legacy alias for OPENROUTER_GEMINI_IMAGE_MODEL:
# IMAGE_MODEL=google/gemini-2.5-flash-image-preview
#
# UI: which families appear in the Enhance tool's switch (when OpenRouter is active)
# OPENROUTER_UI_FAMILIES=gemini,openai
# OPENROUTER_DEFAULT_FAMILY=gemini
#
# Output cap for OCR / text translation (default 2048). Includes the model's hidden reasoning,
# and formulas are written as LaTeX — dense full pages need ~8192 or the OCR result gets cut off.
# OPENROUTER_VISION_MAX_TOKENS=8192

# OpenRouter attribution (optional) — shown on openrouter.ai activity / rankings
# APP_URL=http://localhost:5173
# APP_NAME=AI Image Optimizer

# ── Timeouts ─────────────────────────────────────────────────────────
# Max seconds one request may wait on AI models (all fallbacks included), default 280.
# Keep it a bit under "maxDuration" in vercel.json (300) so a slow model ends with a clear
# "took too long" error instead of Vercel's "Task timed out after N seconds".
# AI_TIMEOUT_SECONDS=280

PORT=3001
